+/* Aquarium-style Bubble Animation */
+
+.aquarium-container {
+    position: fixed;
+    left: 1.5rem;
+    top: 0;
+    bottom: 0;
+    width: 170px;
+    z-index: 40;
+    overflow: hidden;
+    pointer-events: none;
+}
+
+/* Track that floats upward using CSS animation */
+.bubbles-track {
+    position: absolute;
+    bottom: -50px;
+    left: 0;
+    right: 0;
+    display: flex;
+    flex-direction: column;
+    align-items: flex-start;
+    gap: 1.25rem;
+    padding: 1rem 0.5rem;
+    pointer-events: auto;
+
+    /* CSS Animation for floating up */
+    animation: floatUp 18s linear infinite;
+}
+
+@keyframes floatUp {
+    0% {
+        transform: translateY(0);
+    }
+
+    100% {
+        transform: translateY(-600px);
+    }
+}
+
+/* PAUSE the animation on hover */
+.aquarium-container.paused .bubbles-track {
+    animation-play-state: paused;
+}
+
+.aquarium-bubble {
+    position: relative;
+    padding: 0.7rem 1rem;
+    border-radius: 18px;
+    border: 1px solid rgba(99, 102, 241, 0.35);
+    background: linear-gradient(135deg,
+            rgba(99, 102, 241, 0.12) 0%,
+            rgba(139, 92, 246, 0.08) 100%);
+    backdrop-filter: blur(10px);
+    cursor: pointer;
+    text-align: left;
+    max-width: 155px;
+    width: fit-content;
+    flex-shrink: 0;
+    transition: max-width 0.3s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
+    box-shadow:
+        0 4px 20px rgba(99, 102, 241, 0.12),
+        inset 0 1px 0 rgba(255, 255, 255, 0.15);
+}
+
+/* Bubble shine effect */
+.bubble-shine {
+    position: absolute;
+    top: 6px;
+    left: 12px;
+    width: 16px;
+    height: 10px;
+    background: linear-gradient(135deg,
+            rgba(255, 255, 255, 0.45) 0%,
+            transparent 100%);
+    border-radius: 50%;
+    pointer-events: none;
+}
+
+/* Short title - shown by default */
+.bubble-title {
+    display: block;
+    font-size: 0.75rem;
+    font-weight: 500;
+    color: var(--text-primary);
+    line-height: 1.3;
+    transition: all 0.25s ease;
+}
+
+/* Full question - hidden by default */
+.bubble-question {
+    display: none;
+    font-size: 0.72rem;
+    color: var(--text-secondary);
+    line-height: 1.4;
+    margin-top: 0.25rem;
+}
+
+/* Expanded state on hover */
+.aquarium-bubble.expanded {
+    max-width: 220px;
+    z-index: 100;
+    background: linear-gradient(135deg,
+            rgba(99, 102, 241, 0.2) 0%,
+            rgba(139, 92, 246, 0.14) 100%);
+    border-color: rgba(99, 102, 241, 0.55);
+    box-shadow:
+        0 8px 28px rgba(99, 102, 241, 0.2),
+        inset 0 1px 0 rgba(255, 255, 255, 0.25);
+}
+
+.aquarium-bubble.expanded .bubble-title {
+    font-size: 0.68rem;
+    color: var(--text-muted);
+    margin-bottom: 0.15rem;
+}
+
+.aquarium-bubble.expanded .bubble-question {
+    display: block;
+}
+
+.aquarium-bubble:hover {
+    border-color: rgba(99, 102, 241, 0.6);
+}
+
+/* Dark theme */
+[data-theme="dark"] .aquarium-bubble {
+    background: linear-gradient(135deg,
+            rgba(99, 102, 241, 0.16) 0%,
+            rgba(139, 92, 246, 0.1) 100%);
+}
+
+/* Light theme */
+[data-theme="light"] .aquarium-bubble {
+    background: linear-gradient(135deg,
+            rgba(99, 102, 241, 0.08) 0%,
+            rgba(139, 92, 246, 0.05) 100%);
+    border-color: rgba(99, 102, 241, 0.25);
+    box-shadow:
+        0 4px 15px rgba(99, 102, 241, 0.08),
+        inset 0 1px 0 rgba(255, 255, 255, 0.6);
+}
+
+/* Responsive */
+@media (max-width: 1024px) {
+    .aquarium-container {
+        display: none;
+    }
+}
+
+@media (max-width: 1280px) and (min-width: 1025px) {
+    .aquarium-container {
+        left: 0.75rem;
+        width: 145px;
+    }
+
+    .aquarium-bubble {
+        max-width: 130px;
+        padding: 0.55rem 0.8rem;
+    }
+
+    .bubble-question {
+        font-size: 0.68rem;
+    }
+}
